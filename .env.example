# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Nigdy nie wpisuj prawdziwych sekretów do tego pliku.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Hasło warsztatowe do wejścia na czat
CHAT_PASSWORD=
# Losowy sekret do podpisywania sesji (min. 32 znaki), np. wygenerowany poleceniem:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
